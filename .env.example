# Copy this file to .env and fill only the variables required for your run.
# Never commit the resulting .env file.

# API access (only required for GPT/OpenRouter analyses)
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OUTCOME_LLM_MODEL=openai/gpt-5.2

# Restricted inputs retained outside the public repository
OUTCOME_DATASET_CSV=
OUTCOME_BINARY_DATASET_CSV=
OUTCOME_TEST_MANIFEST=

# Locally retained checkpoints and prediction artifacts
OUTCOME_REFERENCE_CHECKPOINT=
OUTCOME_PRIMARY_PREDICTIONS=
OUTCOME_PUBMEDBERT_CHECKPOINT=
OUTCOME_BIOBERT_CHECKPOINT=
OUTCOME_SCIBERT_CHECKPOINT=
OUTCOME_GPT10_PREDICTIONS=
OUTCOME_GPT18_PREDICTIONS=
